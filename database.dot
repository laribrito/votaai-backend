digraph DatabaseSchema {
  graph [
    rankdir=LR,
    nodesep=0.6,
    ranksep=1.2,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    pad="0.5",
    splines=true,
    concentrate=false,
    bgcolor="#FFFFFF"
  ];
  node [shape=none, fontname="Helvetica,Arial,sans-serif", fontsize=10];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8, color="#475569", penwidth=1.2];

