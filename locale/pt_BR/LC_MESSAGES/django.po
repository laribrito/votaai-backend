msgid "Question '%(q_name)s' must contain at least one option."
msgstr "A pergunta '%(q_name)s' deve conter pelo menos uma opção."

#: Controllers/actions/election/electionActions.py:86
msgid "The election title is required."
msgstr "O título da eleição é obrigatório."

#: Controllers/actions/election/electionActions.py:88
msgid "The ballot structure is required."
msgstr "A estrutura da cédula é obrigatória."

#: Controllers/actions/election/electionActions.py:90
msgid "The electoral college is required."
msgstr "O colégio eleitoral é obrigatório."

#: Controllers/actions/election/electionActions.py:92
msgid "The election public key is required."
msgstr "A chave pública da eleição é obrigatória."

#: Controllers/actions/election/electionActions.py:94
msgid "The keyHandle is required."
msgstr "O keyHandle é obrigatório."

#: Controllers/actions/election/electionActions.py:96
msgid "The machine digital signature is required."
msgstr "A assinatura digital da máquina é obrigatória."

#: Controllers/actions/election/electionActions.py:118
msgid "Physical machine signature is invalid or payload does not match."
msgstr "A assinatura da máquina física é inválida ou o payload não corresponde."

#: Controllers/actions/election/electionActions.py:135
msgid ""
"Could not identify the authenticated user or physical machine owner to "
"create the election."
msgstr "Não foi possível identificar o usuário autenticado ou o proprietário da máquina física para criar a eleição."

#: Controllers/actions/election/electionActions.py:140
msgid "An election with this keyHandle already exists."
msgstr "Já existe uma eleição com este keyHandle."

#: Controllers/actions/election/electionActions.py:250
#, python-format
msgid "Error generating server digital signature: %(error)s"
msgstr "Erro ao gerar assinatura digital do servidor: %(error)s"

#: Controllers/actions/election/electionActions.py:295
msgid "This election is not open or available for public tracking."
msgstr "Esta eleição não está aberta ou disponível para acompanhamento público."

#: Controllers/actions/election/electionActions.py:388
#: Controllers/actions/election/electionActions.py:499
#: Controllers/actions/election/electionActions.py:608
msgid "The election key handle is required."
msgstr "O key handle da eleição é obrigatório."

#: Controllers/actions/election/electionActions.py:400
msgid "This election has already been closed."
msgstr "Esta eleição já foi encerrada."

#: Controllers/actions/election/electionActions.py:402
#: Controllers/actions/election/electionActions.py:627
msgid "This election has already been tallied."
msgstr "Esta eleição já foi apurada."

#: Controllers/actions/election/electionActions.py:404
msgid "Cannot close an election that has not been started yet."
msgstr "Não é possível encerrar uma eleição que ainda não foi iniciada."

#: Controllers/actions/election/electionActions.py:406
msgid "This election is not in an active voting state."
msgstr "Esta eleição não está em estado ativo de votação."

#: Controllers/actions/election/electionActions.py:413
msgid "Only the administrator that created this election can close it."
msgstr "Apenas o administrador que criou esta eleição pode encerrá-la."

#: Controllers/actions/election/electionActions.py:417
msgid "Only the physical machine that created this election can close it."
msgstr "Apenas a máquina física que criou esta eleição pode encerrá-la."

#: Controllers/actions/election/electionActions.py:463
msgid "Election closed successfully. Voter quorum is locked."
msgstr "Eleição encerrada com sucesso. O quórum de eleitores foi bloqueado."

#: Controllers/actions/election/electionActions.py:513
msgid "Votes can only be retrieved for closed or tallied elections."
msgstr "Os votos só podem ser recuperados para eleições encerradas ou apuradas."

#: Controllers/actions/election/electionActions.py:522
msgid ""
"Only the administrator that created this election can retrieve votes for "
"tallying."
msgstr "Apenas o administrador que criou esta eleição pode recuperar os votos para apuração."

#: Controllers/actions/election/electionActions.py:526
msgid ""
"Only the physical machine that created this election can retrieve votes for "
"tallying."
msgstr "Apenas a máquina física que criou esta eleição pode recuperar os votos para apuração."

#: Controllers/actions/election/electionActions.py:610
msgid "The tally cryptographic hash is required."
msgstr "O hash criptográfico da apuração é obrigatório."

#: Controllers/actions/election/electionActions.py:612
msgid "The election private key is required for tally verification."
msgstr "A chave privada da eleição é obrigatória para a verificação da apuração."

#: Controllers/actions/election/electionActions.py:614
msgid "The tally results are required and cannot be empty."
msgstr "Os resultados da apuração são obrigatórios e não podem estar vazios."

#: Controllers/actions/election/electionActions.py:629
msgid ""
"Cannot tally an election while voting is still in progress. Close it first."
msgstr "Não é possível apurar uma eleição enquanto a votação ainda está em andamento. Encerre-a primeiro."

#: Controllers/actions/election/electionActions.py:631
msgid "Cannot tally an election that has not been started."
msgstr "Não é possível apurar uma eleição que não foi iniciada."

#: Controllers/actions/election/electionActions.py:633
msgid "Election is not in a closed state."
msgstr "A eleição não está em estado encerrado."

#: Controllers/actions/election/electionActions.py:640
msgid "Only the administrator that created this election can tally it."
msgstr "Apenas o administrador que criou esta eleição pode apurá-la."

#: Controllers/actions/election/electionActions.py:644
msgid ""
"Only the authenticated physical machine that created this election can tally "
"it."
msgstr "Apenas a máquina física autenticada que criou esta eleição pode apurá-la."

#: Controllers/actions/election/electionActions.py:651
msgid "Invalid private key format. PEM PKCS#8 expected."
msgstr "Formato de chave privada inválido. Esperado PEM PKCS#8."

#: Controllers/actions/election/electionActions.py:661
msgid "The provided private key does not match the election's public key."
msgstr "A chave privada fornecida não corresponde à chave pública da eleição."

#: Controllers/actions/election/electionActions.py:710
msgid ""
"The tally results cannot be zeroed out when ballots exist in the election."
msgstr "Os resultados da apuração não podem estar zerados quando existem votos na eleição."

#: Controllers/actions/election/electionActions.py:756
msgid ""
"Election tally saved successfully. Private key recorded for public "
"verification."
msgstr "Apuração da eleição salva com sucesso. Chave privada registrada para verificação pública."

#: Controllers/actions/election/electionActions.py:780
msgid "Audit packages are only available for tallied elections (TALLIED)."
msgstr "Os pacotes de auditoria estão disponíveis apenas para eleições apuradas (TALLIED)."

#: Controllers/actions/election/electionActions.py:785
msgid "The private key for this election is not available."
msgstr "A chave privada desta eleição não está disponível."

#: Controllers/actions/vote/voteActions.py:56
#: Controllers/actions/vote/voteActions.py:245
msgid ""
"Too many invalid attempts from this IP address. Access temporarily suspended."
msgstr "Muitas tentativas inválidas deste endereço IP. Acesso temporariamente suspenso."

#: Controllers/actions/vote/voteActions.py:59
#: Controllers/actions/vote/voteActions.py:248
msgid "The voting token is required."
msgstr "O token de votação é obrigatório."

#: Controllers/actions/vote/voteActions.py:62
#: Controllers/actions/vote/voteActions.py:251
msgid "The machine public key is required."
msgstr "A chave pública da máquina é obrigatória."

#: Controllers/actions/vote/voteActions.py:65
