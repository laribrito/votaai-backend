msgstr "Pré-cadastro iniciado com sucesso. Um código de verificação foi enviado para o seu e-mail."

#: Controllers/actions/admin/adminPreRegistrationActions.py:261
msgid "No pending email verification found. Please restart pre-registration."
msgstr "Nenhuma verificação de e-mail pendente encontrada. Reinicie o pré-cadastro."

#: Controllers/actions/admin/adminPreRegistrationActions.py:266
msgid "Verification code has expired. Please request a new code."
msgstr "O código de verificação expirou. Solicite um novo código."

#: Controllers/actions/admin/adminPreRegistrationActions.py:271
msgid "Too many failed verification attempts. Please request a new code."
msgstr "Muitas tentativas de verificação inválidas. Solicite um novo código."

#: Controllers/actions/admin/adminPreRegistrationActions.py:278
msgid "Invalid verification code."
msgstr "Código de verificação inválido."

#: Controllers/actions/admin/adminPreRegistrationActions.py:296
msgid ""
"Email verified successfully. Configure your authenticator app and send the "
