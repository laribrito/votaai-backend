msgstr "Esta eleição não está aberta para votação."

#: Controllers/actions/vote/voteActions.py:106
#: Controllers/actions/vote/voteActions.py:297
msgid "This voter has already cast their ballot."
msgstr "Este eleitor já registrou o seu voto."

#: Controllers/actions/vote/voteActions.py:122
#: Controllers/actions/vote/voteActions.py:317
msgid "Replay detected: this nonce has already been used."
msgstr "Replay detectado: este nonce já foi utilizado."

#: Controllers/actions/vote/voteActions.py:138
msgid ""
"Access denied: only hardware-backed keys (TEE or StrongBox) are accepted."
msgstr "Acesso negado: apenas chaves protegidas por hardware (TEE ou StrongBox) são aceitas."

#: Controllers/actions/vote/voteActions.py:254
msgid "The encrypted vote content is required."
msgstr "O conteúdo criptografado do voto é obrigatório."

#: Controllers/actions/vote/voteActions.py:309
msgid "Access denied: this voting token is bound to a different mobile device."
msgstr "Acesso negado: este token de votação está vinculado a outro dispositivo móvel."

#: Controllers/actions/vote/voteActions.py:332
msgid "Invalid digital signature for the ballot payload."
msgstr "Assinatura digital inválida para o payload da cédula."

#: Controllers/actions/vote/voteActions.py:343
msgid "Invalid or unrecognized vote ID for this election."
msgstr "ID de voto inválido ou não reconhecido para esta eleição."

#: Controllers/actions/vote/voteActions.py:349
msgid "This vote ID has already been consumed."
msgstr "Este ID de voto já foi utilizado."

