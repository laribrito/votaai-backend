msgstr "Este token de votação já foi utilizado."

#: Controllers/actions/vote/voteActions.py:95
#: Controllers/actions/vote/voteActions.py:286
msgid "This election has not started yet."
msgstr "Esta eleição ainda não foi iniciada."

#: Controllers/actions/vote/voteActions.py:97
#: Controllers/actions/vote/voteActions.py:288
msgid "This election has already closed."
msgstr "Esta eleição já foi encerrada."

#: Controllers/actions/vote/voteActions.py:99
#: Controllers/actions/vote/voteActions.py:290
