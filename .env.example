DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
APP_NAME=My App
API_TITLE=My API
API_DESCRIPTION=API documentation.

# docker & automações do entrypoint
CONTAINER_PREFIX=django-api-template
ENABLE_MIGRATIONS=True
ENABLE_SEED=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Database
DB_NAME=myapp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=your_password_here
DEFAULT_FROM_EMAIL=no-reply@myapp.com


# Divulgação de eleições em andamento
ELECTION_INFO_URL=http://localhost:5173/eleicoes

# Link / Deep Link de votação para aplicativo mobile (desacoplado; padrão: votaai://votar/?token=)
MOBILE_VOTING_URL=votaai://votar/?token=

# Chave privada ECDSA P-256 (PEM) para assinatura assimétrica dos QR Codes de votação (votaai-qr:v2)
QR_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Link / URL web para exibição segura do QR Code (validação direta na View com ?token=)
WEB_VOTING_URL=http://localhost:8000/votar/?token=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Limite máximo de tentativas inválidas de solicitação de voto antes do bloqueio
VOTING_TOKEN_MAX_FAILED_ATTEMPTS=3

# Nível de log da aplicação para auditoria (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Exigir atestação estrita de hardware Android KeyStore (True = produção TEE/StrongBox; False = desenvolvimento)
REQUIRE_HARDWARE_ATTESTATION=True
