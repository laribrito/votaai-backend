DEBUG=True
# Obrigatória: gere uma chave forte e única para cada ambiente (sem fallback no código)
SECRET_KEY=replace-with-a-strong-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
APP_NAME=VotaAí
API_TITLE=VotaAí API
API_DESCRIPTION=API do ecossistema de votação eletrônica VotaAí.

# Exposição de interfaces administrativas e documentação (em produção com DEBUG=False, o padrão é False)
ENABLE_ADMIN=True
ENABLE_API_DOCS=True

# Rate Limiting / Throttling Global (DRF)
THROTTLE_RATE_ANON=60/minute
THROTTLE_RATE_USER=120/minute

# docker & automações do entrypoint
CONTAINER_PREFIX=django-api-template
ENABLE_MIGRATIONS=True
ENABLE_SEED=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Database
DB_NAME=myapp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Cache Distribuído (Redis)
REDIS_URL=redis://redis:6379/1
REDIS_PORT=6379

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=your_password_here
DEFAULT_FROM_EMAIL=no-reply@myapp.com


# Divulgação de eleições em andamento
ELECTION_INFO_URL=http://localhost:5173/eleicoes

# Link / Deep Link de votação para aplicativo mobile (desacoplado; padrão: votaai://votar/?token=)
MOBILE_VOTING_URL=votaai://votar/?token=

# Chave privada ECDSA P-256 (PEM) obrigatória para assinatura assimétrica dos QR Codes de votação (votaai-qr:v2)
QR_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nREPLACE_WITH_YOUR_ECDSA_P256_PRIVATE_KEY\n-----END EC PRIVATE KEY-----"

# Link / URL web para exibição segura do QR Code (validação direta na View com ?token=)
WEB_VOTING_URL=http://localhost:8000/votar/?token=

# Hardening HTTP e Cookies (cabeçalhos de segurança e política de cookies)
X_FRAME_OPTIONS=DENY
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Segurança em Produção com HTTPS / Proxy Reverso (ative USE_HTTPS=True atrás de TLS)
USE_HTTPS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Limite máximo de tentativas inválidas de solicitação de voto antes do bloqueio
VOTING_TOKEN_MAX_FAILED_ATTEMPTS=3

# Nível de log da aplicação para auditoria (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Exigir atestação estrita de hardware Android KeyStore (True = produção TEE/StrongBox; False = desenvolvimento)
REQUIRE_HARDWARE_ATTESTATION=True
